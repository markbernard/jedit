<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>jedit</groupId>
    <artifactId>jedit</artifactId>
    <version>1.0.0</version>
    <name>JEdit</name>


    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>16</maven.compiler.release>
    </properties>

    <dependencies>
        <!-- Source: https://mvnrepository.com/artifact/com.fifesoft/rsyntaxtextarea -->
        <dependency>
            <groupId>com.fifesoft</groupId>
            <artifactId>rsyntaxtextarea</artifactId>
            <version>4.0.1</version>
        </dependency>

        <!-- Source: https://mvnrepository.com/artifact/org.apache.tika/tika-app -->
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-core</artifactId>
            <version>4.2.0</version>
        </dependency>

        <dependency>
            <groupId>org.apache.jmeter</groupId>
            <artifactId>jorphan</artifactId>
            <version>5.6.3</version>
        </dependency>

        <!-- Source: https://mvnrepository.com/artifact/org.simpleframework/simple-xml -->
        <dependency>
            <groupId>org.simpleframework</groupId>
            <artifactId>simple-xml</artifactId>
            <version>2.7.1</version>
            <scope>compile</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.1</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>io.github.markbernard.jedit.JEdit</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
              <groupId>de.dentrassi.maven</groupId>
              <artifactId>rpm</artifactId>
              <version>1.10.1</version>
              <executions>
                <execution>
                  <id>build-rpm</id>
                  <goals>
                    <goal>rpm</goal>
                  </goals>
                </execution>
              </executions>
              <configuration>
                <packageName>${project.artifactId}</packageName>
                <group>Application/Misc</group>
                <packager>Mark Bernard</packager>
                <requires>
                  <require>
                    <name>jre</name>
                    <version>16</version>
                    <greaterOrEqual/>
                  </require>
                </requires>
                <entries>
                  <entry>
                    <name>/usr/bin/jedit</name>
                    <file>${project.basedir}/src/main/scripts/jedit.sh</file>
                    <mode>0755</mode>
                  </entry>
                  <entry>
                    <name>/opt/jedit/jedit.png</name>
                    <file>${project.basedir}/src/main/os_app_res/jedit.png</file>
                    <mode>0644</mode>
                  </entry>
                  <entry>
                    <name>/usr/share/applications/jedit.desktop</name>
                    <file>${project.basedir}/src/main/os_app_res/jedit.desktop</file>
                    <mode>0644</mode>
                  </entry>
                  <entry>
                    <name>/opt/jedit/${project.build.finalName}.jar</name>
                    <file>${project.build.directory}/${project.build.finalName}.jar</file>
                    <mode>0644</mode>
                  </entry>
                </entries>
              </configuration>
            </plugin>
            <plugin>
                <artifactId>jdeb</artifactId>
                <groupId>org.vafer</groupId>
                <version>1.14</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>jdeb</goal>
                        </goals>
                        <configuration>
                            <controlDir>${basedir}/src/main/deb</controlDir>
                            <dataSet>
                                <data>
                                    <src>${project.build.directory}/${project.build.finalName}.jar</src>
                                    <type>file</type>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>/opt/${project.artifactId}</prefix>
                                    </mapper>
                                </data>
                                <data>
                                    <src>src/main/os_app_res/jedit.png</src>
                                    <dst>/opt/${project.artifactId}/jedit.png</dst>
                                    <type>file</type>
                                    <mapper>
                                        <type>perm</type>
                                        <user>root</user>
                                        <group>root</group>
                                        <filemode>644</filemode>
                                    </mapper>
                                </data>
                                <data>
                                    <src>src/main/os_app_res/jedit.desktop</src>
                                    <dst>/usr/share/applications/jedit.desktop</dst>
                                    <type>file</type>
                                    <mapper>
                                        <type>perm</type>
                                        <user>root</user>
                                        <group>root</group>
                                        <filemode>644</filemode>
                                    </mapper>
                                </data>
                                <data>
                                    <src>src/main/scripts/jedit.sh</src>
                                    <dst>/usr/bin/jedit</dst>
                                    <type>file</type>
                                    <mapper>
                                        <type>perm</type>
                                        <user>root</user>
                                        <group>root</group>
                                        <filemode>755</filemode>
                                    </mapper>
                                </data>
                                <data>
                                    <type>template</type>
                                    <paths>
                                        <path>/var/log/${project.artifactId}</path>
                                    </paths>
                                </data>
                            </dataSet>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.7.1</version>
                <configuration>
                    <descriptors>
                        <descriptor>src/main/assembly/zip.xml</descriptor>
                    </descriptors>
                    <finalName>jedit</finalName>
                </configuration>
                <executions>
                    <execution>
                        <id>make-assembly</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
